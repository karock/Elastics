//
//  Signing.xcconfig
//  Code signing for Elastics and Elastics Preferences (included by both projects).
//
//  Defaults to "Sign to Run Locally" (ad-hoc), which works on the Mac that built it.
//  To sign with your own certificate, run scripts/configure-signing.sh: it writes
//  Signing.local.xcconfig (git-ignored) with your identity and team, which
//  overrides the values below.
//

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS =

// Xcode otherwise adds com.apple.security.get-task-allow (lets debuggers attach)
// to every build it signs, and notarization rejects executables that have it.
// Keep it for Debug builds only.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Debug] = YES

#include? "Signing.local.xcconfig"
